{
  "name": "dsh-model-surplus",
  "version": "0.4.1",
  "description": "DeepSeek Harness plugin: shows model usage, plan quota and account balance in the session header — OpenCode Go plan usage (rolling / weekly / monthly) with the selected model's monthly cap, DeepSeek account balance, and Command Code 5-hour / weekly windows with remaining credits — each only while a matching model is the active selection.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tests/test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "opencode",
    "opencode-go",
    "commandcode",
    "command-code",
    "deepseek",
    "usage",
    "surplus",
    "quota",
    "balance"
  ],
  "license": "MIT",
  "author": {
    "name": "itchenshi",
    "url": "https://github.com/itchenshi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itchenshi/dsh-model-surplus.git"
  },
  "homepage": "https://github.com/itchenshi/dsh-model-surplus#readme",
  "bugs": {
    "url": "https://github.com/itchenshi/dsh-model-surplus/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "compatibility": {
      "node": ">=20",
      "dshReleases": {
        "0.1.5-rc.2": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
